# =========================================================
# PassageVPN — environment template — environment template
# Copy to .env and adjust. Never commit .env.
# Full reference: docs/configuration.md
# =========================================================

# --- Product / branding ---
PASSAGE_BRAND_NAME=PassageVPN

# --- Data & storage ---
# Top-level runtime data directory (dev default; docker-compose overrides it).
PASSAGE_DATA_DIR=./data
PASSAGE_DB_URL=jdbc:sqlite:./data/passage.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=on
PASSAGE_DB_USER=
PASSAGE_DB_PASSWORD=
# The directory variables below are overridden per-environment in
# docker-compose.yml; they matter mainly for local (non-container) runs.
PASSAGE_PKI_DIR=./data/pki
PASSAGE_CCD_DIR=./data/ccd
PASSAGE_CONFIG_DIR=./data/config
PASSAGE_SCRIPTS_DIR=./data/config/scripts
PASSAGE_SCRIPTS_SRC_DIR=./openvpn/scripts
PASSAGE_LOG_DIR=./data/config/logs
PASSAGE_EASY_RSA_BIN=easyrsa
# Validity of newly issued client/server certificates in days (default 730).
PASSAGE_PKI_CERT_EXPIRE=730

# --- Security ---
# JWT signing secret, minimum 32 bytes. Generate with:
#   openssl rand -base64 48
PASSAGE_JWT_SECRET=change-me-to-a-random-64-byte-secret-please
# Bootstrap admin password (used by setup wizard / seed-admin)
PASSAGE_ADMIN_PASSWORD=change-me
# Auto-seed sample users/groups/rules on first boot after setup (true/false).
# Manual seeding any time: make seed-demo
PASSAGE_DEMO_MODE=false

# Shared secret guarding the /internal/** script-facing endpoints.
# MANDATORY: the backend refuses to start with the placeholder below.
# Generate with:   openssl rand -hex 32
PASSAGE_INTERNAL_TOKEN=change-me-internal-token

# Optional extra secret guarding the bootstrap-only seed endpoints
# (seed-admin / seed-demo). When set, requests must present X-Bootstrap-Token.
# Unlike PASSAGE_INTERNAL_TOKEN this value is NOT exposed to the OpenVPN container,
# so a compromised gateway cannot re-create an admin account.
# Generate with:   openssl rand -hex 32
PASSAGE_BOOTSTRAP_TOKEN=

# Password of the local OpenVPN management interface. MANDATORY: the backend
# refuses to start when unset. The value is written into every daemon config's
# management password file and must match what the gateway's management socket
# enforces (configure the openvpn container accordingly).
# Generate with:   openssl rand -base64 24
PASSAGE_OPENVPN_MGMT_PASSWORD=

# Internal control-plane mTLS listener (agents talk to this endpoint).
# PASSAGE_INTERNAL_TLS_DIR holds the internal CA + server keystore, bootstrapped
# automatically on first start; keep it inside the data volume.
PASSAGE_INTERNAL_MTLS_PORT=9443
# PASSAGE_INTERNAL_TLS_DIR is set per-environment (see docker-compose.yml).

# Login rate limiting (attempts per window, seconds)
PASSAGE_AUTH_PROVIDER=local
PASSAGE_AUTH_RATE_LIMIT_MAX=20
PASSAGE_AUTH_RATE_LIMIT_WINDOW=60

# Comma-separated allowed CORS origins (default: * for local dev).
# Set to your production domain: PASSAGE_CORS_ORIGINS=https://vpn.example.com
# PASSAGE_CORS_ORIGINS=*

# --- OpenVPN integration ---
PASSAGE_OPENVPN_MGMT_HOST=openvpn
PASSAGE_OPENVPN_MGMT_PORT=7505
PASSAGE_OPENVPN_ADMIN_HOST=vpn.example.com

# --- Backend ---
PASSAGE_SERVER_PORT=8080
PASSAGE_LOG_LEVEL=INFO
# Max Tomcat request threads (bounded: fleet admin tool, not a public API).
PASSAGE_TOMCAT_THREADS=50
# Spring profile: sqlite (default) | postgres | agent
#   postgres — run against PostgreSQL (see docker-compose.postgres.yml)
#   agent    — lightweight node agent that registers/heartbeats to a central backend
PASSAGE_PROFILE=sqlite
# Swagger UI / OpenAPI docs (/swagger-ui.html, /v3/api-docs). Off by default so
# the API surface is not exposed in production; enable only for development.
PASSAGE_API_DOCS_ENABLED=false
# CIDR ranges allowed to set X-Forwarded-For (reverse proxy IPs).
# Default covers Docker's default bridge subnets.
PASSAGE_TRUSTED_PROXIES=172.16.0.0/12

# --- Frontend ---
PASSAGE_FRONTEND_PORT=8080
# Dev-only: backend target of the Vite dev-server proxy (frontend/vite.config.ts).
PASSAGE_VITE_PROXY_TARGET=http://backend:8080

# --- Docker compose ---
# Host ports published to the OpenVPN UDP/TCP listeners. PASSAGE_OPENVPN_PORT and
# PASSAGE_OPENVPN_TCP_PORT are the range START (base); the *_END counterpart widens the
# published range so additional daemons are reachable (default = single port, the base
# itself). Backend auto-assigns a daemon the next free port within its protocol range,
# and rejects explicit daemon ports outside it. Daemon listen ports are the SAME numbers
# inside and outside the container.
PASSAGE_OPENVPN_PORT=1194
PASSAGE_OPENVPN_PORT_END=1194
PASSAGE_OPENVPN_TCP_PORT=1195
PASSAGE_OPENVPN_TCP_PORT_END=1195

# Prebuilt container images (release deploy). When PASSAGE_IMAGE_TAG is set and the
# images exist in the registry, "install.sh --mode=release" pulls them instead of
# building from source. PASSAGE_IMAGE_NAMESPACE is the registry path, i.e. your
# GitHub owner/repo — images live at:
#   <PASSAGE_IMAGE_REGISTRY>/<PASSAGE_IMAGE_NAMESPACE>/{backend,frontend,openvpn}:<PASSAGE_IMAGE_TAG>
PASSAGE_IMAGE_REGISTRY=ghcr.io
PASSAGE_IMAGE_NAMESPACE=ugurcsen/passage-vpn
PASSAGE_IMAGE_TAG=latest

# --- Multi-node agent (PASSAGE_PROFILE=agent, compose profile "node") ---
PASSAGE_AGENT_CENTRAL_BASE_URL=https://backend:9443
PASSAGE_AGENT_NODE_NAME=
PASSAGE_AGENT_MGMT_HOST=openvpn
PASSAGE_AGENT_MGMT_PORT_BASE=7505
PASSAGE_AGENT_ADMIN_IP=
PASSAGE_AGENT_HEARTBEAT_SECONDS=30
# Config-bundle pull interval (daemon configs, PKI incl. CRL, CCD, scripts, dnsmasq).
# The agent applies a new bundle only when its content hash changes.
PASSAGE_AGENT_SYNC_SECONDS=60
# Password of the remote gateway's own management interface (required).
PASSAGE_AGENT_MGMT_PASSWORD=
# mTLS client material issued by the central backend via the node admin API
# (POST /api/admin/nodes/{id}/agent-cert). Mounted read-only into the agent.
PASSAGE_AGENT_TLS_CA=/etc/passage/agent/tls/ca.crt
PASSAGE_AGENT_TLS_CERT=/etc/passage/agent/tls/client.crt
PASSAGE_AGENT_TLS_KEY=/etc/passage/agent/tls/client.key
# Host directory holding the agent TLS files (mounted into the agent container)
PASSAGE_AGENT_TLS_DIR=./data/agent-tls

# --- Remote gateway OpenVPN container (compose profile "node") ---
# Callback base URL the remote gateway's scripts use to reach the CENTRAL backend
# (verify-user-pass, client-connect, ...). Defaults to the compose-internal address,
# which only works when the gateway runs on the same Docker network as the central
# stack; a real remote gateway must override this (e.g. https://vpn.example.com:9443).
PASSAGE_NODE_INTERNAL_BASE_URL=
# Host ports of the remote gateway's OpenVPN listeners (base..end; *_END defaults to the base).
PASSAGE_NODE_OPENVPN_PORT=1196
PASSAGE_NODE_OPENVPN_PORT_END=1196
PASSAGE_NODE_OPENVPN_TCP_PORT=1197
PASSAGE_NODE_OPENVPN_TCP_PORT_END=1197
