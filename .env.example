# =========================================================
# OpenVPN Management Panel — environment template
# Copy to .env and adjust. Never commit .env.
# Full reference: docs/configuration.md
# =========================================================

# --- Product / branding ---
OPNL_BRAND_NAME=OpenVPN Panel

# --- Data & storage ---
# Top-level runtime data directory (dev default; docker-compose overrides it).
OPNL_DATA_DIR=./data
OPNL_DB_URL=jdbc:sqlite:./data/opnl.db?journal_mode=WAL&busy_timeout=5000&foreign_keys=on
OPNL_DB_USER=
OPNL_DB_PASSWORD=
# The directory variables below are overridden per-environment in
# docker-compose.yml; they matter mainly for local (non-container) runs.
OPNL_PKI_DIR=./data/pki
OPNL_CCD_DIR=./data/ccd
OPNL_CONFIG_DIR=./data/config
OPNL_SCRIPTS_DIR=./data/config/scripts
OPNL_SCRIPTS_SRC_DIR=./openvpn/scripts
OPNL_LOG_DIR=./data/config/logs
OPNL_EASY_RSA_BIN=easyrsa

# --- Security ---
# JWT signing secret, minimum 32 bytes. Generate with:
#   openssl rand -base64 48
OPNL_JWT_SECRET=change-me-to-a-random-64-byte-secret-please
# Bootstrap admin password (used by setup wizard / seed-admin)
OPNL_ADMIN_PASSWORD=change-me
# Auto-seed sample users/groups/rules on first boot after setup (true/false).
# Manual seeding any time: make seed-demo
OPNL_DEMO_MODE=false

# Shared secret guarding the /internal/** script-facing endpoints.
# MANDATORY: the backend refuses to start with the placeholder below.
# Generate with:   openssl rand -hex 32
OPNL_INTERNAL_TOKEN=change-me-internal-token

# Password of the local OpenVPN management interface. MANDATORY: the backend
# refuses to start when unset. The value is written into every daemon config's
# management password file and must match what the gateway's management socket
# enforces (configure the openvpn container accordingly).
# Generate with:   openssl rand -base64 24
OPNL_OPENVPN_MGMT_PASSWORD=

# Internal control-plane mTLS listener (agents talk to this endpoint).
# OPNL_INTERNAL_TLS_DIR holds the internal CA + server keystore, bootstrapped
# automatically on first start; keep it inside the data volume.
OPNL_INTERNAL_MTLS_PORT=9443
# OPNL_INTERNAL_TLS_DIR is set per-environment (see docker-compose.yml).

# Login rate limiting (attempts per window, seconds)
OPNL_AUTH_PROVIDER=local
OPNL_AUTH_RATE_LIMIT_MAX=20
OPNL_AUTH_RATE_LIMIT_WINDOW=60

# --- OpenVPN integration ---
OPNL_OPENVPN_MGMT_HOST=openvpn
OPNL_OPENVPN_MGMT_PORT=7505
OPNL_OPENVPN_ADMIN_HOST=vpn.example.com

# --- Backend ---
OPNL_SERVER_PORT=8080
OPNL_LOG_LEVEL=INFO
# Max Tomcat request threads (bounded: fleet admin tool, not a public API).
OPNL_TOMCAT_THREADS=50
# Spring profile: sqlite (default) | postgres | agent
#   postgres — run against PostgreSQL (see docker-compose.postgres.yml)
#   agent    — lightweight node agent that registers/heartbeats to a central backend
OPNL_PROFILE=sqlite
# CIDR ranges allowed to set X-Forwarded-For (reverse proxy IPs).
# Default covers Docker's default bridge subnets.
OPNL_TRUSTED_PROXIES=172.16.0.0/12

# --- Frontend ---
OPNL_FRONTEND_PORT=8080
# Dev-only: backend target of the Vite dev-server proxy (frontend/vite.config.ts).
OPNL_VITE_PROXY_TARGET=http://backend:8080

# --- Docker compose ---
# Host ports mapped to the OpenVPN listeners.
OPNL_OPENVPN_PORT=1194
OPNL_OPENVPN_TCP_PORT=1195

# --- Multi-node agent (OPNL_PROFILE=agent, compose profile "node") ---
OPNL_AGENT_CENTRAL_BASE_URL=https://backend:9443
OPNL_AGENT_NODE_NAME=
OPNL_AGENT_MGMT_HOST=openvpn
OPNL_AGENT_MGMT_PORT_BASE=7505
OPNL_AGENT_ADMIN_IP=
OPNL_AGENT_HEARTBEAT_SECONDS=30
# Password of the remote gateway's own management interface (required).
OPNL_AGENT_MGMT_PASSWORD=
# mTLS client material issued by the central backend via the node admin API
# (POST /api/admin/nodes/{id}/agent-cert). Mounted read-only into the agent.
OPNL_AGENT_TLS_CA=/etc/opnl/agent/tls/ca.crt
OPNL_AGENT_TLS_CERT=/etc/opnl/agent/tls/client.crt
OPNL_AGENT_TLS_KEY=/etc/opnl/agent/tls/client.key
# Host directory holding the agent TLS files (mounted into the agent container)
OPNL_AGENT_TLS_DIR=./data/agent-tls
